# Bloquear acceso HTTP directo a archivos internos
# (no afecta require_once de PHP, solo peticiones HTTP)
<FilesMatch "^(config\.php|config\.example\.php|sheets\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Bloquear acceso al directorio vendor
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^vendor/ - [F,L]
</IfModule>
